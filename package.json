{
  "name": "dsh-github-login",
  "productName": "DSH GitHub Login",
  "version": "0.1.0",
  "description": "独立的 GitHub 可视化登录工具：设备码流程、零终端，令牌同步 gh CLI",
  "main": "main.js",
  "author": "Noob-stupid",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dsh.github.login",
    "productName": "DSH GitHub Login",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DSH-GitHub-Login.exe"
    }
  }
}
